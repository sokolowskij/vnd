# Backend service: FastAPI dashboard/API runtime
FROM python:3.11-slim as base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# AWS backend is dashboard/API only. Local generation and publishing use
# requirements.txt on the Windows PC, where Playwright/LM Studio run.
COPY requirements.aws-backend.txt .
RUN pip install --no-cache-dir -r requirements.aws-backend.txt

# Copy application code
COPY src/ /app/src/
COPY pyproject.toml .
COPY README.md .

# Install package code without pulling local-only dependencies such as Playwright.
RUN pip install --no-cache-dir --no-deps -e .

# Create data directories for persistent dashboard state.
RUN mkdir -p /app/data/{products,ready_to_publish,auth}

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run FastAPI server
CMD ["python", "-m", "uvicorn", "agentic_seller.api:app", "--host", "0.0.0.0", "--port", "8000"]

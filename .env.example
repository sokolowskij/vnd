# Local Windows generation configuration.
# LM Studio runs on the local PC, not inside Docker.
LOCAL_MODEL_API=http://localhost:1234/v1
OPENAI_API_KEY=local-model
OPENAI_MODEL=google/gemma-4-e4b

# Local publishing configuration.
DEFAULT_CURRENCY=PLN
POST_MODE=dry_run
HEADLESS=true

# Optional marketplaces (set to true to enable)
ENABLE_OLX=true
ENABLE_FACEBOOK=true

# Local browser profiles used by Playwright publishing.
USER_DATA_DIR=browser_profiles

# AWS dashboard/API port configuration.
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Login sessions
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Data retention
PENDING_RETENTION_DAYS=90
READY_RETENTION_DAYS=30
RETENTION_CHECK_HOURS=24

# Daily product-data backup email
# The backup includes product folders and ready-to-publish folders.
# It does not include auth files or browser profiles.
DAILY_BACKUP_ENABLED=false
DAILY_BACKUP_HOUR_UTC=3
MAX_BACKUP_EMAIL_MB=20
ADMIN_BACKUP_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
